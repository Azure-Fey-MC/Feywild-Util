{
	"schemaVersion": 1,
	"id": "feywild",
	"version": "${version}",
	"name": "Feywild Util",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Azure Fey MC"
	],
	"contributors": [
		"Teal Wolf 25",
		"Elegast Kelural",
		"CephalonCosmic",
		"BluSpring"
	],
	"contact": {
		"homepage": "https://azurefey.tw25.net/",
		"sources": "https://github.com/Azure-Fey-MC/Feywild-Util"
	},
	"license": "MIT",
	"icon": "assets/feywild/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"adapter": "kotlin",
				"value": "net.tw25.azurefey.feywild.FeywildUtilMod"
			}
		],
		"client": [
			{
				"adapter": "kotlin",
				"value": "net.tw25.azurefey.feywild.client.FeywildUtilModClient"
			}
		]
	},
	"mixins": [
		"feywild.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"midnightlib": ">=1.10.0"
	}
}